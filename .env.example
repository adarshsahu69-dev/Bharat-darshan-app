# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps (Android native map tiles)
# 1. Create a project in https://console.cloud.google.com/
# 2. Enable "Maps SDK for Android"
# 3. Create an API key and restrict it to your Android app's package + SHA-1
# 4. Paste it below. Without a real key the app still runs, but Android release
#    builds show a blank map (Expo Go and iOS use Apple/Google tiles instead).
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=YOUR_GOOGLE_MAPS_ANDROID_KEY